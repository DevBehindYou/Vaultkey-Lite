<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Still no INTERNET permission anywhere in the merged manifest — the app
      module doesn't add one either. This is the one line a reviewer (or a
      curious user with `aapt dump permissions`) can check to confirm the
      "fully offline" claim across all four modules at once.
    -->

    <application
        android:name=".VaultKeyApplication"
        android:allowBackup="false"
        android:label="VaultKey"
        android:theme="@style/Theme.VaultKey"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The keyboard <service> and autofill <service> entries come in
             automatically via manifest merging from the :keyboard and
             :autofill module dependencies — nothing to duplicate here. -->
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Still no INTERNET permission in the release manifest — see the note in
      src/debug/AndroidManifest.xml about why the DEBUG build differs, and
      DEPLOYMENT.md for how to verify the shipped release APK/AAB has none.
    -->

    <application
        android:name=".VaultKeyApplication"
        android:label="VaultKey"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- The keyboard <service> and autofill <service> entries come in
             automatically via manifest merging from the :keyboard and
             :autofill module dependencies declared in build.gradle.kts. -->
    </application>
</manifest>
